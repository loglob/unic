PROJECT_NAME           = "Unic"
PROJECT_BRIEF          = "A C unicode library"
INPUT                  = ./include/unic.h ./include/u8text.h
OUTPUT_DIRECTORY       = doc
OPTIMIZE_OUTPUT_FOR_C  = YES
ENABLE_PREPROCESSING   = YES
MACRO_EXPANSION        = YES
EXPAND_ONLY_PREDEF     = YES
EXTRACT_ALL            = YES
STRIP_FROM_PATH        = ./include/
GENERATE_MAN           = YES
